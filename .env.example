# ── Stellium Server ───────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
JWT_SECRET=bitte-aendern-langer-zufalls-string
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# Erstes Konto, das beim Erststart entsteht. Leer lassen -> Name des
# Systembenutzers. Absichtlich nicht "admin" oder "root": genau diese Namen
# probieren automatisierte Anmeldeversuche zuerst durch.
OWNER_HANDLE=
OWNER_NAME=

# ── KI / Übersetzung (Groq) ───────────────────────────────────────
# Key holen: https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelle werden automatisch gewählt: der Server fragt beim Start Groqs
# Modell-Liste ab, sortiert Whisper/TTS/Guard aus und nimmt das größte
# brauchbare Modell für Übersetzung und das kleinste für Antwortvorschläge.
# Alle sechs Stunden wird nachgesehen, ob Groq etwas Neues anbietet.
#
# Nur ausfüllen, wenn du ein bestimmtes Modell erzwingen willst:
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# Alternative Provider (optional)
# AI_PROVIDER=deepl        -> DEEPL_API_KEY=...
# AI_PROVIDER=libre        -> LIBRE_URL=http://localhost:5000
# AI_PROVIDER=demo         -> ohne Key, markiert Texte nur (nur zum Ausprobieren)
DEEPL_API_KEY=
LIBRE_URL=http://localhost:5000

# ── Sprachnachrichten abtippen ────────────────────────────────────
# Ein whisper.cpp-Dienst auf demselben Rechner. Damit bleibt die Aufnahme im
# Haus — sonst ginge sie an Groq, auch wenn das Textmodell längst lokal läuft.
# Einrichten: sudo bash server-setup/dienste/stimme-einrichten.sh
#
# Leer lassen heißt: kein lokaler Dienst. Dann wird über Groq abgetippt,
# falls ein Schlüssel vorliegt, und sonst gar nicht.
STIMME_URL=http://127.0.0.1:8788
# Nur für die Anzeige und fürs Protokoll im Transkript.
STIMME_MODELL=whisper-base
# Eine Minute Aufnahme braucht auf einem Pi 5 um die halbe Minute; warten
# mehrere Aufnahmen, kommt das dazu. Lieber spät fertig als grundlos leer.
# STIMME_TIMEOUT_MS=600000
# STIMME_WARTESCHLANGE=8

# Übersetzungs-Cache (Einträge im Speicher, DB-Cache ist unbegrenzt)
TRANSLATION_MEMORY_CACHE=5000

# ── Web Push (Benachrichtigungen aufs Telefon, auch wenn die App zu ist) ──
# Nichts davon ist Pflicht: fehlt das Schlüsselpaar, erzeugt der Server beim
# ersten Start eins und legt es in data/.vapid-keys.json ab. Nur ausfüllen,
# wenn ein bestimmtes Paar gelten soll (z. B. "npx web-push
# generate-vapid-keys") oder auf mehreren Servern dasselbe gelten muss.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Kontaktadresse für die Push-Dienste (Apple, Google, Mozilla) — falls von
# diesem Server aus Missbrauch gemeldet werden müsste. Ohne eigene Angabe
# steht hier ein Platzhalter; er verhindert nichts, aber eine echte Adresse
# ist höflicher.
# VAPID_SUBJECT=mailto:dein-name@example.com
