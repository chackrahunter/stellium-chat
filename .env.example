# ── Stellium Server ───────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0
JWT_SECRET=bitte-aendern-langer-zufalls-string
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# ── KI / Übersetzung (Groq) ───────────────────────────────────────
# Key holen: https://console.groq.com/keys
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Modelle werden automatisch gewählt: der Server fragt beim Start Groqs
# Modell-Liste ab, sortiert Whisper/TTS/Guard aus und nimmt das größte
# brauchbare Modell für Übersetzung und das kleinste für Antwortvorschläge.
# Alle sechs Stunden wird nachgesehen, ob Groq etwas Neues anbietet.
#
# Nur ausfüllen, wenn du ein bestimmtes Modell erzwingen willst:
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant

# Alternative Provider (optional)
# AI_PROVIDER=deepl        -> DEEPL_API_KEY=...
# AI_PROVIDER=libre        -> LIBRE_URL=http://localhost:5000
# AI_PROVIDER=demo         -> ohne Key, markiert Texte nur (nur zum Ausprobieren)
DEEPL_API_KEY=
LIBRE_URL=http://localhost:5000

# Übersetzungs-Cache (Einträge im Speicher, DB-Cache ist unbegrenzt)
TRANSLATION_MEMORY_CACHE=5000
